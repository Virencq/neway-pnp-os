#!/bin/bash
set -Eeuo pipefail

# OpenPnP 2.6 release commit. Pin by immutable commit, not a moving branch/tag.
readonly OPENPNP_REPOSITORY="https://github.com/openpnp/openpnp.git"
readonly OPENPNP_COMMIT="5bd404cfc70f34103a3ca0fbb6b50c2b465f407c"
readonly BUILD_ROOT="/tmp/neway-openpnp-build"
readonly INSTALL_ROOT="/opt/openpnp"

command -v git >/dev/null
command -v mvn >/dev/null
command -v javac >/dev/null
install -d -m 0755 /var/log/neway
exec > >(tee -a /var/log/neway/openpnp-build.log) 2>&1

echo "Building OpenPnP pinned commit ${OPENPNP_COMMIT}"
rm -rf -- "${BUILD_ROOT}"
git init "${BUILD_ROOT}"
git -C "${BUILD_ROOT}" remote add origin "${OPENPNP_REPOSITORY}"
git -C "${BUILD_ROOT}" fetch --depth=1 origin "${OPENPNP_COMMIT}"
git -C "${BUILD_ROOT}" checkout --detach FETCH_HEAD
actual_commit="$(git -C "${BUILD_ROOT}" rev-parse HEAD)"
if [[ "${actual_commit}" != "${OPENPNP_COMMIT}" ]]; then
  echo "ERROR: OpenPnP source commit mismatch: ${actual_commit}" >&2
  exit 1
fi

cd "${BUILD_ROOT}"
mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true package

readonly APP_JAR="target/openpnp-gui-0.0.1-alpha-SNAPSHOT.jar"
if [[ ! -s "${APP_JAR}" || ! -d target/lib ]]; then
  echo "ERROR: expected OpenPnP jar/dependency directory missing after Maven build." >&2
  exit 1
fi

install -d -m 0755 "${INSTALL_ROOT}/target"
install -m 0644 "${APP_JAR}" "${INSTALL_ROOT}/target/"
cp -a target/lib "${INSTALL_ROOT}/target/lib"
printf '%s\n' "${OPENPNP_COMMIT}" > "${INSTALL_ROOT}/OPENPNP_COMMIT"
chmod 0644 "${INSTALL_ROOT}/OPENPNP_COMMIT"

# Run the application as a dedicated unprivileged operator.
if ! id neway >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash neway
fi
for group in dialout video plugdev input render; do
  if getent group "${group}" >/dev/null 2>&1; then
    usermod -aG "${group}" neway
  fi
done
install -d -o neway -g neway -m 0750 /home/neway/.local/state/neway
install -d -o neway -g neway -m 0750 /home/neway/.openpnp
chmod 0755 /usr/local/bin/neway-openpnp /usr/local/bin/neway-openpnp-session
chmod 0644 /home/neway/.bash_profile
chmod 0755 /home/neway/.xinitrc

# Start a local autologin console; the operator account has no password login.
passwd --lock neway
install -d -m 0755 /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin neway --noclear %I $TERM
Type=idle
EOF

# Remove build-only packages while keeping the explicitly requested JRE.
apt-get purge -y git maven openjdk-21-jdk
apt-get autoremove -y
rm -rf "${BUILD_ROOT}" /root/.m2 /var/lib/apt/lists/*
echo "OpenPnP installation complete; source commit ${actual_commit}"
