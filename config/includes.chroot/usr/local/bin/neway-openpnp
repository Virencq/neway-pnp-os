#!/bin/sh
set -eu

APP_DIR=/opt/openpnp
JAR="$APP_DIR/openpnp-gui.jar"
LIB_DIR="$APP_DIR/lib"
LOG_DIR="${HOME}/.local/state/neway"
LOG_FILE="$LOG_DIR/openpnp.log"
CONFIG_DIR="${HOME}/.openpnp2"

# Prepare user-owned Xorg and OpenPnP state directories before startup.
mkdir -p "${HOME}/.local/share/xorg" "$CONFIG_DIR" "$LOG_DIR"
chown -R "$(id -un):$(id -gn)" "${HOME}/.local" "$CONFIG_DIR"
if [ ! -r "$JAR" ] || [ ! -d "$LIB_DIR" ] || ! find "$LIB_DIR" -maxdepth 1 -type f -name '*.jar' -print -quit | grep -q .; then
    printf '%s\n' "Neway OpenPnP application or runtime libraries are missing under $APP_DIR." | tee -a "$LOG_FILE" >&2
    exit 1
fi

cd "$APP_DIR"
exec /usr/bin/java \
    --add-opens=java.base/java.lang=ALL-UNNAMED \
    --add-opens=java.desktop/java.awt=ALL-UNNAMED \
    -Dsun.awt.disableMixing=true \
    -cp "$JAR:$LIB_DIR/*" \
    org.openpnp.Main >>"$LOG_FILE" 2>&1
