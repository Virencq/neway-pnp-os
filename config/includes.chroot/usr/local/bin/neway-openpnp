#!/bin/bash
set -Eeuo pipefail
readonly APP_DIR="/opt/openpnp"
readonly APP_JAR="${APP_DIR}/target/openpnp-gui-0.0.1-alpha-SNAPSHOT.jar"
if [[ ! -s "${APP_JAR}" ]]; then
  echo "OpenPnP application is missing: ${APP_JAR}" >&2
  exit 127
fi
cd "${APP_DIR}"
exec /usr/bin/java \
  --add-opens=java.base/java.lang=ALL-UNNAMED \
  --add-opens=java.desktop/java.awt=ALL-UNNAMED \
  --add-opens=java.desktop/java.awt.color=ALL-UNNAMED \
  -jar "${APP_JAR}" "$@"
