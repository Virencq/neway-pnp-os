#!/bin/sh
set -eu

APP_DIR=/opt/openpnp
JAR="$APP_DIR/openpnp-gui.jar"
LOG_DIR="${HOME}/.local/state/neway"
LOG_FILE="$LOG_DIR/openpnp.log"

mkdir -p "$LOG_DIR"
if [ ! -r "$JAR" ]; then
    printf '%s\n' "Neway OpenPnP application JAR is missing: $JAR" | tee -a "$LOG_FILE" >&2
    exit 1
fi

cd "$APP_DIR"
exec /usr/bin/java -Dsun.awt.disableMixing=true -jar "$JAR" >>"$LOG_FILE" 2>&1
