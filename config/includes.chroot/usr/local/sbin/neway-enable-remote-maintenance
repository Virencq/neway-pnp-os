#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || { echo "Run as root." >&2; exit 77; }

GUARD=/usr/local/sbin/neway-remote-maintenance-guard
MARKER=/etc/neway/maintenance-enabled

"$GUARD" --preflight
systemctl enable --now nftables.service
systemctl is-active --quiet nftables.service || {
    echo "Firewall did not become active; SSH remains disabled." >&2
    exit 1
}
systemctl enable --now wg-quick@wg0.service
ip link show wg0 >/dev/null 2>&1 || {
    systemctl stop wg-quick@wg0.service || true
    echo "WireGuard interface wg0 did not come up; SSH remains disabled." >&2
    exit 1
}

install -d -o root -g root -m 0755 /etc/neway
install -o root -g root -m 0600 /dev/null "$MARKER"
if ! systemctl enable --now ssh.service || ! systemctl is-active --quiet ssh.service; then
    rm -f "$MARKER"
    systemctl stop ssh.service || true
    echo "SSH did not become active; the maintenance gate was removed." >&2
    exit 1
fi

echo "Remote maintenance enabled on the provisioned private VPN. Confirm access from an authorized technician endpoint."
